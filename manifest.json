{
  "manifest_version": 3,
  "name": "Meridian — Twitch Chat for YouTube™ & Kick",
  "version": "1.1.0",
  "description": "Bring Twitch chat to YouTube™ & Kick. Transparent overlay, docked mode, 3rd-party emotes, chat delay, highlights.",
  "key": "",
  "icons": {
    "16": "icons/meridian-16.png",
    "32": "icons/meridian-32.png",
    "48": "icons/meridian-48.png",
    "128": "icons/meridian-128.png"
  },
  "permissions": [
    "storage",
    "identity",
    "activeTab"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://kick.com/*",
    "https://*.kick.com/*",
    "https://*.twitch.tv/*",
    "https://id.twitch.tv/*",
    "https://api.twitch.tv/*",
    "https://7tv.io/*",
    "https://api.betterttv.net/*",
    "https://cdn.betterttv.net/*",
    "https://api.frankerfacez.com/*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "Meridian"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://kick.com/*",
        "https://*.kick.com/*"
      ],
      "js": [
        "src/content.js"
      ],
      "css": [
        "src/overlay.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/overlay.css",
        "src/twitch-irc.js",
        "src/emotes.js",
        "src/highlights.js",
        "src/mappings.js"
      ],
      "matches": [
        "https://www.youtube.com/*",
        "https://kick.com/*",
        "https://*.kick.com/*"
      ]
    }
  ]
}
